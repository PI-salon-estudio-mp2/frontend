# Copia este archivo como .env.local y completa los valores.
# NO pongas valores reales en este archivo: se sube al repositorio.

# URL base de la API (backend-api) SIN barra final.
#   Local con npm run dev en el backend: http://localhost:3000
#   Producción (Render):       https://backend-api-7xa7.onrender.com
VITE_API_URL=

# Endpoint de la base técnica (TS-00). Debe coincidir con el contrato del BE Lead.
VITE_API_DATO_PATH=/api/base-tecnica

# Sprint 1 (Firebase Authentication). Se agregan cuando se configure TS-01:
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
